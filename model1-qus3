import java.util.*;
public class Playfair {
    private static final int SIZE = 5;
    private static char[][] keyMatrix = new char[SIZE][SIZE];
    public static void generateKeyMatrix(String key) {
        boolean[] present = new boolean[26];
        key = key.replaceAll("[Jj]", "I").toUpperCase();
        StringBuilder keyString = new StringBuilder();
        for (char ch : key.toCharArray()) {
            if (Character.isLetter(ch) && !present[ch - 'A']) {
                keyString.append(ch);
                present[ch - 'A'] = true;
            }
        }
        for (char ch = 'A'; ch <= 'Z'; ch++) {
            if (ch != 'J' && !present[ch - 'A']) {
                keyString.append(ch);
            }
        }
        int index = 0;
        for (int i = 0; i < SIZE; i++) {
            for (int j = 0; j < SIZE; j++) {
                keyMatrix[i][j] = keyString.charAt(index++);
            }
        }
    }
    public static void printKeyMatrix() {
        for (char[] row : keyMatrix) {
            for (char ch : row) {
                System.out.print(ch + " ");
            }
            System.out.println();
        }
    }
    private static String preprocessMessage(String message) {
        message = message.replaceAll("[^A-Z]", "").replaceAll("[J]", "I");
        StringBuilder result = new StringBuilder();
        for (int i = 0; i < message.length(); i++) {
            char a = message.charAt(i);
            char b = (i + 1 < message.length()) ? message.charAt(i + 1) : 'X';
            if (a == b) {
                result.append(a).append('X');
            } else {
                result.append(a).append(b);
                i++; 
            }
        }
        if (result.length() % 2 != 0) {
            result.append('X');
        }
        return result.toString();
    }
    private static int[] findPosition(char ch) {
        for (int i = 0; i < SIZE; i++) {
            for (int j = 0; j < SIZE; j++) {
                if (keyMatrix[i][j] == ch) {
                    return new int[]{i, j};
                }
            }
        }
        return null;
    }
    public static String encrypt(String message) {
        message = preprocessMessage(message.toUpperCase().replaceAll("[J]", "I"));
        StringBuilder encrypted = new StringBuilder();

        for (int i = 0; i < message.length(); i += 2) {
            char a = message.charAt(i);
            char b = message.charAt(i + 1);
            int[] posA = findPosition(a);
            int[] posB = findPosition(b);

            if (posA[0] == posB[0]) {
                encrypted.append(keyMatrix[posA[0]][(posA[1] + 1) % SIZE]);
                encrypted.append(keyMatrix[posB[0]][(posB[1] + 1) % SIZE]);
            } else if (posA[1] == posB[1]) {
                encrypted.append(keyMatrix[(posA[0] + 1) % SIZE][posA[1]]);
                encrypted.append(keyMatrix[(posB[0] + 1) % SIZE][posB[1]]);
            } else {
                encrypted.append(keyMatrix[posA[0]][posB[1]]);
                encrypted.append(keyMatrix[posB[0]][posA[1]]);
            }
        }
        return encrypted.toString();
    }
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        String key=sc.nextLine();
        String message = sc.nextLine();

        generateKeyMatrix(key);
        System.out.println("Key Matrix:");
        printKeyMatrix();

        String encryptedMessage = encrypt(message);
        System.out.println("\nEncrypted Message: " + encryptedMessage);
    }
}
