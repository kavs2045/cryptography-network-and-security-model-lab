import java.util.Scanner;
public class RailFenceWithSpecialChars {
    public static String encrypt(String text, int rails) {
        if (rails <= 1) return text;
 
        StringBuilder[] rail = new StringBuilder[rails];
        for (int i = 0; i < rails; i++) {
            rail[i] = new StringBuilder();
        }
 
        int direction = 1; // 1 for down, -1 for up
        int row = 0;
 
        for (char ch : text.toCharArray()) {
            rail[row].append(ch);
            row += direction;
 
            if (row == 0 || row == rails - 1) {
                direction *= -1;
            }
        }
 
        StringBuilder result = new StringBuilder();
        for (StringBuilder sb : rail) {
            result.append(sb);
        }
 
        return result.toString();
    }
    public static String decrypt(String cipher, int rails) {
        if (rails <= 1) return cipher;
 
        boolean[][] marker = new boolean[rails][cipher.length()];
        int direction = 1, row = 0;
 
        for (int i = 0; i < cipher.length(); i++) {
            marker[row][i] = true;
            row += direction;
            if (row == 0 || row == rails - 1) {
                direction *= -1;
            }
        }
 
        char[][] grid = new char[rails][cipher.length()];
        int index = 0;
        for (int i = 0; i < rails; i++) {
            for (int j = 0; j < cipher.length(); j++) {
                if (marker[i][j]) {
                    grid[i][j] = cipher.charAt(index++);
                }
            }
        }
 
        StringBuilder result = new StringBuilder();
        row = 0;
        direction = 1;
        for (int i = 0; i < cipher.length(); i++) {
            result.append(grid[row][i]);
            row += direction;
            if (row == 0 || row == rails - 1) {
                direction *= -1;
            }
        }
 
        return result.toString();
    }
 
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter the message to encrypt: ");
        String message = scanner.nextLine(); 
 
        System.out.print("Enter number of rails (e.g., 4): ");
        int rails = scanner.nextInt();
        String encrypted = encrypt(message, rails);
        String decrypted = decrypt(encrypted, rails);
        System.out.println("\nEncrypted Message: " + encrypted);
        System.out.println("Decrypted Message: " + decrypted);
 
        scanner.close();
    }
} 
