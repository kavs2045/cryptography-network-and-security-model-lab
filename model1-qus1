import java.util.*;
public class PlayfairCipher {
    private static char[][] matrix = new char[5][5];
    private static Map<Character, int[]> charPos = new HashMap<>();
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter the key: ");
        String key = scanner.nextLine();
        System.out.print("Enter the message: ");
        String message = scanner.nextLine();
        prepareMatrix(key);
        System.out.println("\nPlayfair Matrix:");
        printMatrix();
        String encrypted = encrypt(message);
        System.out.println("\nEncrypted: " + encrypted);
        String decrypted = decrypt(encrypted);
        System.out.println("Decrypted: " + decrypted);
    }
    private static void prepareMatrix(String key) {
        boolean[] used = new boolean[26];
        key = key.toUpperCase().replaceAll("[^A-Z]", "").replace("J", "I");
        StringBuilder sb = new StringBuilder();
        for (char c : key.toCharArray()) {
            if (!used[c - 'A']) {
                sb.append(c);
                used[c - 'A'] = true;
            }
        }
        for (char c = 'A'; c <= 'Z'; c++) {
            if (c == 'J') continue;
            if (!used[c - 'A']) {
                sb.append(c);
                used[c - 'A'] = true;
            }
        }
        String fullKey = sb.toString();
        int index = 0;
        for (int i = 0; i < 5; i++) {
            for (int j = 0; j < 5; j++) {
                char ch = fullKey.charAt(index++);
                matrix[i][j] = ch;
                charPos.put(ch, new int[]{i, j});
            }
        }
    }
    private static void printMatrix() {
        for (int i = 0; i < 5; i++) {
            for (int j = 0; j < 5; j++) {
                System.out.print(matrix[i][j] + " ");
            }
            System.out.println();
        }
    }
    private static String encrypt(String message) {
        List<String> pairs = preparePairs(message);
        StringBuilder encrypted = new StringBuilder();
        for (String pair : pairs) {
            encrypted.append(encryptPair(pair.charAt(0), pair.charAt(1)));
        }
        return encrypted.toString();
    }
    private static String decrypt(String message) {
        List<String> pairs = new ArrayList<>();
        for (int i = 0; i < message.length(); i += 2) {
            pairs.add(message.substring(i, i + 2));
        }
        StringBuilder decrypted = new StringBuilder();
        for (String pair : pairs) {
            decrypted.append(decryptPair(pair.charAt(0), pair.charAt(1)));
        }
        return decrypted.toString().replace("X", "");
    }
    private static List<String> preparePairs(String message) {
        message = message.toUpperCase().replaceAll("[^A-Z]", "").replace("J", "I");
        List<String> pairs = new ArrayList<>();
        int i = 0;
        while (i < message.length()) {
            char first = message.charAt(i);
            char second;
            if (i + 1 < message.length()) {
                second = message.charAt(i + 1);
                if (first == second) {
                    second = 'X';
                    i++;
                } else {
                    i += 2;
                }
            } else {
                second = 'X';
                i++;
            }
            pairs.add("" + first + second);
        }
        return pairs;
    }
    private static String encryptPair(char a, char b) {
        int[] posA = charPos.get(a);
        int[] posB = charPos.get(b);
        if (posA[0] == posB[0]) {
            return "" + matrix[posA[0]][(posA[1] + 1) % 5] + matrix[posB[0]][(posB[1] + 1) % 5];
        } else if (posA[1] == posB[1]) {
            return "" + matrix[(posA[0] + 1) % 5][posA[1]] + matrix[(posB[0] + 1) % 5][posB[1]];
        } else {
            return "" + matrix[posA[0]][posB[1]] + matrix[posB[0]][posA[1]];
        }
    }
    private static String decryptPair(char a, char b) {
        int[] posA = charPos.get(a);
        int[] posB = charPos.get(b);
        if (posA[0] == posB[0]) {
            return "" + matrix[posA[0]][(posA[1] + 4) % 5] + matrix[posB[0]][(posB[1] + 4) % 5];
        } else if (posA[1] == posB[1]) {
            return "" + matrix[(posA[0] + 4) % 5][posA[1]] + matrix[(posB[0] + 4) % 5][posB[1]];
        } else {
            return "" + matrix[posA[0]][posB[1]] + matrix[posB[0]][posA[1]];
        }
    }
}

